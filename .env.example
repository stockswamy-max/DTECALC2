# ==============================================================================
# LendClear DTI Calculator — Environment Configuration Template
# Copy this file to .env and customize for your deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Network Settings
# ------------------------------------------------------------------------------
# Host to bind the application server to (0.0.0.0 binds to all network interfaces)
HOST=0.0.0.0

# Port for FastAPI application (default: 3000 for Coolify / Traefik reverse proxy)
PORT=3000

# ------------------------------------------------------------------------------
# Database Layer (PostgreSQL)
# ------------------------------------------------------------------------------
# Standard PostgreSQL connection string format:
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Note: On Coolify, when using a PostgreSQL service in the same project/network,
# you can use the service name or internal IP as HOST.
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/dte_calc

# Database connection pool sizing (optional, defaults: min=1, max=10)
DB_POOL_MIN=1
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# Security & CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (use '*' to allow all, or specify domains)
# Example: https://dti.yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# Frontend Build Arguments (Optional)
# ------------------------------------------------------------------------------
# If deploying frontend and backend to separate domains, specify the backend URL.
# If using the unified single-container deployment (recommended), leave empty.
REACT_APP_BACKEND_URL=
